rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdminEmail() {
      return request.auth != null &&
             request.auth.token.email != null &&
             (request.auth.token.email == 'antho.pruneta@gmail.com' ||
              request.auth.token.email == 'cronos2a@hotmail.fr');
    }

    match /characters/{userId}/{allPaths=**} {
      // Lecture : tout le monde peut voir les images
      allow read: if true;

      // Écriture : seulement l'admin
      allow write: if isAdminEmail();
    }

    // Proto V2 — portraits uploadés par le joueur (son dossier uniquement)
    match /v2Portraits/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 8 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Config d'équilibrage (page Admin) : lecture pour tous (chargement de l'app), écriture admin uniquement
    match /gameConfig/{fileName} {
      allow read: if true;
      allow write: if isAdminEmail();
    }
  }
}
