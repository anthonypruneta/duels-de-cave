rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             (request.auth.token.email == 'antho.pruneta@gmail.com' ||
              request.auth.token.email == 'cronos2a@hotmail.fr');
    }

    // Règles pour la collection 'characters'
    match /characters/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Sous-collection de snapshots de stats pour l'audit anti-triche.
      // Le joueur ne peut QUE créer un snapshot de son propre personnage.
      // Il ne peut ni les modifier, ni les supprimer : seul l'admin peut.
      match /statSnapshots/{snapshotId} {
        allow read: if request.auth != null &&
                       (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null &&
                         request.auth.uid == userId;
        allow update, delete: if isAdmin();
      }
    }

    // Requêtes collectionGroup('statSnapshots') pour l'audit admin
    match /{path=**}/statSnapshots/{snapshotId} {
      allow read: if isAdmin();
    }

    // Règles pour la collection 'dungeonProgress'
    match /dungeonProgress/{userId} {
      allow read: if request.auth != null;
      // Les champs sensibles (runsAvailable, lastCreditDate, totalRuns, etc.) sont gérés côté Cloud Functions.
      // On n'autorise côté client que quelques flags "meta" (Mirror/Boss Rush) + admin.
      function allowedClientKeys() {
        return [
          'bossRushCompleted',
          'bossRushCompletions',
          'bossRushLastCountedWeekId',
          'lastMirrorDate',
          'updatedAt'
        ];
      }

      function isAllowedClientWrite() {
        return request.auth != null &&
               request.auth.uid == userId &&
               (
                 // Create
                 (!exists(/databases/$(database)/documents/dungeonProgress/$(userId)) &&
                  request.resource.data.keys().hasOnly(allowedClientKeys())) ||
                 // Update
                 (exists(/databases/$(database)/documents/dungeonProgress/$(userId)) &&
                  request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedClientKeys()))
               );
      }

      allow create, update: if isAllowedClientWrite() || isAdmin();
      allow delete: if isAdmin();
    }

    // Broadcasts admin (pop-up d'annonce globale)
    match /adminBroadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Configuration globale du jeu (équilibrage persistant)
    match /gameConfig/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Milestones globaux (premiers kills/clears)
    match /globalMilestones/{milestoneId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Règles pour les rolls en attente (lock du roll)
    match /pendingRolls/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Règles pour le tournoi
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /combatLogs/{matchId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      // Chat spectateurs (vidé à la fin du tournoi côté serveur logique / admin)
      match /chatMessages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 400 &&
                         request.resource.data.characterName is string &&
                         request.resource.data.characterName.size() <= 100;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Paris tournoi (runs) — tournoi « current » : paris autorisés sans doc tournoi ou en phase preparation uniquement
      match /userBets/{userId} {
        function tournamentCurrent() {
          return tournamentId == 'current';
        }
        function tournamentTPath() {
          return /databases/$(database)/documents/tournaments/$(tournamentId);
        }
        function tournamentAllowsUserBetWrites() {
          return !exists(tournamentTPath()) ||
                 get(tournamentTPath()).data.statut == 'preparation';
        }
        function validParticipantId(pid) {
          return pid is string && pid.size() > 0 && pid.size() <= 128;
        }
        // Le SDK envoie souvent des nombres en double : « is int » refuse et provoque permission-denied.
        function validRunsStakedNumber(n) {
          return n is number && n >= 1 && n <= 500000;
        }
        // Pas de blocs if/let sur chemins : le parseur Firestore ne les accepte pas dans les fonctions.
        function inTournamentParticipantsMap(participantId) {
          return exists(tournamentTPath()) &&
            get(tournamentTPath()).data.participants is map &&
            get(tournamentTPath()).data.participants.keys().hasAny([participantId]);
        }
        function betTargetOkFromTournamentMap(participantId) {
          return get(tournamentTPath()).data.participants[participantId] is map &&
            get(tournamentTPath()).data.participants[participantId].keys().hasAll(['ownerUserId']) &&
            string(get(tournamentTPath()).data.participants[participantId].ownerUserId) != string(request.auth.uid);
        }
        function betTargetOkFromCharacterDoc(participantId) {
          return exists(/databases/$(database)/documents/characters/$(participantId)) &&
            get(/databases/$(database)/documents/characters/$(participantId)).data.archived != true &&
            get(/databases/$(database)/documents/characters/$(participantId)).data.disabled != true &&
            string(participantId) != string(request.auth.uid);
        }
        function betTargetIsNotOwnCharacter(participantId) {
          return (inTournamentParticipantsMap(participantId) && betTargetOkFromTournamentMap(participantId)) ||
            (!inTournamentParticipantsMap(participantId) && betTargetOkFromCharacterDoc(participantId));
        }
        function validUserBetCreate() {
          return validParticipantId(request.resource.data.participantId) &&
                 validRunsStakedNumber(request.resource.data.runsStaked) &&
                 request.resource.data.updatedAt == request.time &&
                 betTargetIsNotOwnCharacter(request.resource.data.participantId);
        }
        function validUserBetUpdate() {
          return request.resource.data.participantId == resource.data.participantId &&
                 validParticipantId(request.resource.data.participantId) &&
                 validRunsStakedNumber(request.resource.data.runsStaked) &&
                 request.resource.data.runsStaked > resource.data.runsStaked &&
                 request.resource.data.runsStaked <= resource.data.runsStaked + 50000 &&
                 request.resource.data.runsStaked <= 500000 &&
                 request.resource.data.updatedAt == request.time &&
                 betTargetIsNotOwnCharacter(request.resource.data.participantId);
        }

        allow read: if request.auth != null;

        allow create: if request.auth != null &&
                         request.auth.uid == userId &&
                         tournamentCurrent() &&
                         tournamentAllowsUserBetWrites() &&
                         validUserBetCreate();

        allow update: if request.auth != null &&
                         request.auth.uid == userId &&
                         tournamentCurrent() &&
                         tournamentAllowsUserBetWrites() &&
                         validUserBetUpdate();

        // Joueur : annulation tant que pas de tournoi ou phase preparation. Admin : nettoyage sous-collection au nouveau tournoi.
        allow delete: if request.auth != null &&
                         tournamentCurrent() &&
                         ((request.auth.uid == userId && tournamentAllowsUserBetWrites()) || isAdmin());
      }
    }

    // Archives tournoi (arbre + combatLogs pour replay Hall of Fame)
    match /tournamentArchives/{archiveId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /combatLogs/{matchId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Méta tournoi (qualifié samedi issu du tournoi des anciens)
    match /tournamentMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Champions du tournoi des anciens : retraite définitive (id = doc archivedCharacters)
    match /legacyRetiredArchives/{archiveId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Règles pour le Hall of Fame
    match /hallOfFame/{entryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Règles pour les personnages archivés
    match /archivedCharacters/{charId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Récompenses compte (rerolls, boss rush, cataclysme, labyrinthe étage 90, forge, extension, tournoi…)
    // Le client écrit avec merge + increment() et des transactions : pas de hasOnly sur le doc entier.
    // Restriction stricte par liste de clés est incompatible avec merge sans Cloud Functions.
    match /tournamentRewards/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());

      allow write: if isAdmin();

      allow create, update: if request.auth != null &&
                               (request.auth.uid == userId || isAdmin());

      allow delete: if isAdmin();
    }

    // Labyrinthe infini hebdomadaire
    match /weeklyInfiniteLabyrinths/{weekId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Boss mondial (Cataclysme)
    match /worldBossEvent/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /damages/{characterId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Proto V2 (sandbox) — un doc par joueur
    match /v2Prototype/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Préférences utilisateur
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Taverne
    match /tavernePresence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /taverneChat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Progression Labyrinthe par joueur et par semaine
    match /userLabyrinthProgress/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());

      match /weeks/{weekId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
                       (request.auth.uid == userId || isAdmin());
      }
    }

    // ============================================================
    // Rogue-like (runs + leaderboard) - MVP
    // ============================================================
    // Structure :
    // - rogueLikeRuns/{userId}/runs/{runId}
    // - rogueLikeLeaderboard/{entryId}

    match /rogueLikeRuns/{userId} {
      // Lecture : utilisateurs connectés
      allow read: if request.auth != null;

      // Écriture : propriétaire du run
      match /runs/{runId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /rogueLikeLeaderboard/{entryId} {
      // Lecture : utilisateurs connectés
      allow read: if request.auth != null;

      // Écriture : seulement le propriétaire (doit correspondre à payload.userId)
      allow write: if request.auth != null &&
                    request.auth.uid == request.resource.data.userId;
    }

    // ============================================================
    // Cave Destiny (runs perso + Panthéon global)
    // ============================================================
    // Accès : TOUT joueur authentifié (pas réservé admin).
    // - Lire Mes runs / Panthéon : auth
    // - Écrire sa propre run + entrée panthéon : propriétaire (uid)
    // - Supprimer : admin seulement
    // Structure :
    // - caveDestinyRuns/{userId}/runs/{runId}
    // - caveDestinyPantheon/{runId}

    match /caveDestinyRuns/{userId} {
      allow read: if request.auth != null;

      match /runs/{runId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                         request.auth.uid == userId &&
                         request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null &&
                         request.auth.uid == userId &&
                         resource.data.userId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /caveDestinyPantheon/{runId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Donjon coop « Rouge » (salle + quota journalier)
    match /coopDungeonRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.hostId == request.auth.uid;
      // Hôte ou invité ; première jointure ; invité quitte (guestId → null) ; champs prêt / lobby
      allow update: if request.auth != null && (
                       resource.data.hostId == request.auth.uid ||
                       resource.data.guestId == request.auth.uid ||
                       (resource.data.guestId == null &&
                        request.resource.data.guestId == request.auth.uid)
                     );
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    match /coopDungeonDaily/{userId} {
      allow read, write: if request.auth != null;
    }

    // Salles PvP joueurs (lobby, anciens persos archivés)
    match /pvpLobbyRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null && (
                       resource.data.hostId == request.auth.uid ||
                       resource.data.guestId == request.auth.uid ||
                       (resource.data.guestId == null &&
                        request.resource.data.guestId == request.auth.uid)
                     );
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    // Classement PvP (collection racine — requête orderBy elo sans collectionGroup)
    // Depuis le schéma 2 : champ `elo` (number, 0..3000) optionnel côté règles (défaut 1000 côté client).
    function pvpEloValid() {
      return !('elo' in request.resource.data) ||
             (request.resource.data.elo is number &&
              request.resource.data.elo >= 0 &&
              request.resource.data.elo <= 3000);
    }

    match /pvpDuelLeaderboardEntries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.ownerUserId == request.auth.uid &&
                       request.resource.data.characterId is string &&
                       request.resource.data.characterId.size() > 0 &&
                       entryId == request.auth.uid + '__' + request.resource.data.characterId &&
                       pvpEloValid();
      allow update: if request.auth != null &&
                       resource.data.ownerUserId == request.auth.uid &&
                       request.resource.data.ownerUserId == resource.data.ownerUserId &&
                       request.resource.data.characterId == resource.data.characterId &&
                       entryId == request.auth.uid + '__' + request.resource.data.characterId &&
                       pvpEloValid();
      allow delete: if isAdmin();
    }

    // Stats victoires/défaites + ELO duels PvP lobby (par perso archivé)
    // Sous-collection + synchro vers pvpDuelLeaderboardEntries pour le classement global.
    match /pvpDuelStatsByUser/{userId}/pvpDuelCharStats/{charId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
                               request.auth.uid == userId &&
                               pvpEloValid();
      allow delete: if isAdmin();
    }
    // Ancienne sous-collection (migration / rétrocompat)
    match /pvpDuelStatsByUser/{userId}/characters/{charId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Historique des matchs Red coop (lié au personnage via pseudo normalisé)
    // Chemins :
    // - coopRedMatchHistory/{userId}/charactersByName/{nameKey}/matches/{roomId}
    // - coopRedMatchHistory/{userId}/matches/{roomId} (legacy)
    match /coopRedMatchHistory/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /matches/{matchId} {
        allow read, write, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /charactersByName/{nameKey} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();

        match /matches/{matchId} {
          allow read, write, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }
    }

    // Requêtes collectionGroup('matches') — nécessaire pour l’admin (nettoyage pointeaux) et cohérent avec l’historique Red
    match /{path=**}/matches/{matchId} {
      allow read: if request.auth != null &&
                     path.matches('^coopRedMatchHistory/.*') &&
                     (isAdmin() ||
                      path.matches('^coopRedMatchHistory/' + request.auth.uid + '(/.*)?$'));
      allow create, update, delete: if request.auth != null &&
                                        path.matches('^coopRedMatchHistory/.*') &&
                                        (isAdmin() ||
                                         path.matches('^coopRedMatchHistory/' + request.auth.uid + '(/.*)?$'));
    }
  }
}
