rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'antho.pruneta@gmail.com';
    }

    // Règles pour la collection 'characters'
    match /characters/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Règles pour la collection 'dungeonProgress'
    match /dungeonProgress/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());
    }

    // Broadcasts admin (pop-up d'annonce globale)
    match /adminBroadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Configuration globale du jeu (équilibrage persistant)
    match /gameConfig/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Milestones globaux (premiers kills/clears)
    match /globalMilestones/{milestoneId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Règles pour les rolls en attente (lock du roll)
    match /pendingRolls/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Règles pour le tournoi
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /combatLogs/{matchId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Archives tournoi (arbre + combatLogs pour replay Hall of Fame)
    match /tournamentArchives/{archiveId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /combatLogs/{matchId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Méta tournoi (qualifié samedi issu du tournoi des anciens)
    match /tournamentMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Champions du tournoi des anciens : retraite définitive (id = doc archivedCharacters)
    match /legacyRetiredArchives/{archiveId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Règles pour le Hall of Fame
    match /hallOfFame/{entryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Règles pour les personnages archivés
    match /archivedCharacters/{charId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Récompenses compte (rerolls, boss rush, cataclysme, labyrinthe étage 90, forge, extension, tournoi…)
    // Le client écrit avec merge + increment() et des transactions : pas de hasOnly sur le doc entier.
    // Restriction stricte par liste de clés est incompatible avec merge sans Cloud Functions.
    match /tournamentRewards/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());

      allow write: if isAdmin();

      allow create, update: if request.auth != null &&
                               (request.auth.uid == userId || isAdmin());

      allow delete: if isAdmin();
    }

    // Labyrinthe infini hebdomadaire
    match /weeklyInfiniteLabyrinths/{weekId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Boss mondial (Cataclysme)
    match /worldBossEvent/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /damages/{characterId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Préférences utilisateur
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Taverne
    match /tavernePresence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /taverneChat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Progression Labyrinthe par joueur et par semaine
    match /userLabyrinthProgress/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());

      match /weeks/{weekId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
                       (request.auth.uid == userId || isAdmin());
      }
    }

    // ============================================================
    // Rogue-like (runs + leaderboard) - MVP
    // ============================================================
    // Structure :
    // - rogueLikeRuns/{userId}/runs/{runId}
    // - rogueLikeLeaderboard/{entryId}

    match /rogueLikeRuns/{userId} {
      // Lecture : utilisateurs connectés
      allow read: if request.auth != null;

      // Écriture : propriétaire du run
      match /runs/{runId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /rogueLikeLeaderboard/{entryId} {
      // Lecture : utilisateurs connectés
      allow read: if request.auth != null;

      // Écriture : seulement le propriétaire (doit correspondre à payload.userId)
      allow write: if request.auth != null &&
                    request.auth.uid == request.resource.data.userId;
    }

    // Donjon coop « Rouge » (salle + quota journalier)
    match /coopDungeonRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.hostId == request.auth.uid;
      // Hôte ou invité ; première jointure ; invité quitte (guestId → null) ; champs prêt / lobby
      allow update: if request.auth != null && (
                       resource.data.hostId == request.auth.uid ||
                       resource.data.guestId == request.auth.uid ||
                       (resource.data.guestId == null &&
                        request.resource.data.guestId == request.auth.uid)
                     );
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    match /coopDungeonDaily/{userId} {
      allow read, write: if request.auth != null;
    }

    // Historique des matchs Red coop (un doc par salle pour chaque joueur)
    match /coopRedMatchHistory/{userId} {
      match /matches/{matchId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
